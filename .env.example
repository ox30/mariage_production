# Variables à définir dans Railway (onglet Variables), jamais dans le dépôt.
# En local : copier ce fichier en `.env`, qui est ignoré par Git (EX-SEC-06).

ANTHROPIC_API_KEY=sk-ant-...
MOT_DE_PASSE_ADMIN=un-mot-de-passe-long-et-solide

# EX-IA-20 — le modèle est un paramètre, pas une constante de code.
# claude-sonnet-5 pour la soirée (latence).
# Un modèle supérieur pour l'écriture des chapitres, après l'événement.
MODELE_IA=claude-sonnet-5

# Prénoms des mariés : servent aux libellés du questionnaire (EX-QUE-08) et à
# la compréhension des réponses par le modèle (EX-IA-12). Interdits en sortie.
#
# EX-SEC-18 — LES VALEURS CI-DESSOUS SONT FICTIVES ET DOIVENT LE RESTER.
# Les vrais prénoms ne figurent dans aucun fichier versionné : ils se posent
# dans Railway → Variables, et dans le `.env` local non versionné. Les mêmes
# valeurs fictives servent aux jeux de test.
PRENOM_MARIEE=Solène
PRENOM_MARIE=Gaspard

# EX-ARC-17 — refuse de démarrer si aucun volume n'est monté sur /data.
# Un repli silencieux vers le disque du conteneur perd les données sans
# avertissement. À poser à 1 dans Railway, à laisser vide en local.
EXIGER_VOLUME=1

# EX-SAU-19 et EX-SAU-22 — dépôts objets, doublés chez deux fournisseurs.
# Les IDENTIFIANTS vivent ici et jamais dans config.yaml : le volume est tiré
# par le Pi toutes les 5 minutes (EX-SAU-02) et part dans l'archive
# d'administration (EX-SAU-10). Les y ranger reviendrait à mettre les clés du
# coffre à l'intérieur du coffre.
# Seule la LISTE des destinations actives est dans config.yaml, pour pouvoir
# retirer un dépôt devenu lent sans redéployer (EX-SAU-09).
STOCKAGE_RAILWAY_ENDPOINT=https://…
STOCKAGE_RAILWAY_CLE=…
STOCKAGE_RAILWAY_SECRET=…
STOCKAGE_RAILWAY_BUCKET=mariage
STOCKAGE_RAILWAY_REGION=auto

# R2 exige region_name="auto" ; une région AWS ordinaire y produit une erreur
# de signature difficile à lire. L'endpoint est de la forme
# https://<identifiant-de-compte>.r2.cloudflarestorage.com
STOCKAGE_R2_ENDPOINT=https://…r2.cloudflarestorage.com
STOCKAGE_R2_CLE=…
STOCKAGE_R2_SECRET=…
STOCKAGE_R2_BUCKET=mariage
STOCKAGE_R2_REGION=auto

# Interrupteurs. À 1 en production ; les tests les posent à 0 pour ne pas
# consommer d'appels d'API ni écrire des instantanés en boucle.
WORKER_ACTIF=1
INSTANTANE_ACTIF=1
